{
  "name": "mdpx-cli",
  "version": "0.1.8",
  "description": "Markdown preview in your terminal, with math, Mermaid diagrams, and GitHub styling",
  "keywords": [
    "markdown",
    "preview",
    "terminal",
    "cli",
    "kitty",
    "kitty-graphics",
    "mermaid",
    "katex",
    "github-markdown"
  ],
  "license": "MIT",
  "author": "Kazuki Matsuo <kazuki.matsuo.728@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazu728/mdpx.git"
  },
  "type": "module",
  "bin": {
    "mdpx": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "test": "bun test src/",
    "test:integration": "bun test integration/",
    "test:node": "node integration/node-runtime.mjs",
    "typecheck": "tsc",
    "verify": "bun verification/scheduler.check.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "github-markdown-css": "^5.9.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "puppeteer-core": "25.16.0",
    "shiki": "^4.6.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
