{
  "name": "mdpx",
  "version": "0.1.0",
  "description": "A Markdown viewer for kitty graphics terminals, driven by Chrome snapshots",
  "type": "module",
  "bin": {
    "mdpx": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test src/",
    "test:integration": "for f in integration/*.test.ts; do [ -e \"$f\" ] || continue; bun test \"$f\" || exit 1; done",
    "test:node": "node integration/node-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.1",
    "github-markdown-css": "^5.8.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1",
    "puppeteer-core": "25.3.0",
    "shiki": "^1.24.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^7.0.2"
  }
}
