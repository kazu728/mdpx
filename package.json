{
  "name": "mdpx-cli",
  "version": "0.1.2",
  "description": "Markdown preview in your terminal, with math, Mermaid diagrams, and GitHub styling",
  "keywords": [
    "markdown",
    "preview",
    "terminal",
    "cli",
    "kitty",
    "kitty-graphics",
    "mermaid",
    "katex",
    "github-markdown"
  ],
  "license": "MIT",
  "author": "Kazuki Matsuo <kazuki.matsuo.728@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazu728/mdpx.git"
  },
  "type": "module",
  "bin": {
    "mdpx": "dist/main.js",
    "mdpx-nvim-sync": "dist/nvim-sync.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/main.js dist/nvim-sync.js",
    "test": "bun test src/",
    "test:integration": "for f in integration/*.test.ts; do [ -e \"$f\" ] || continue; bun test \"$f\" || exit 1; done",
    "test:node": "node integration/node-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.1",
    "github-markdown-css": "^5.8.1",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1",
    "puppeteer-core": "25.3.0",
    "shiki": "^1.24.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^7.0.2"
  }
}
